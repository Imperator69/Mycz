APP_NAME="MYCZ Immobilien"
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_URL=https://mycz.gl-ventures.at
APP_TIMEZONE=Europe/Vienna

APP_LOCALE=de
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=de_AT

APP_MAINTENANCE_DRIVER=file

BCRYPT_ROUNDS=12

LOG_CHANNEL=daily
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=warning

# World4You MySQL (Zugangsdaten aus dem World4You-Kundenbereich)
DB_CONNECTION=mysql
DB_HOST=localhost
DB_PORT=3306
DB_DATABASE=
DB_USERNAME=
DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=480
SESSION_ENCRYPT=true
SESSION_PATH=/
SESSION_DOMAIN=null
SESSION_SECURE_COOKIE=true

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=sync

CACHE_STORE=file

# Nur fuer "Passwort vergessen" (World4You-Postfach)
MAIL_MAILER=smtp
MAIL_SCHEME=smtps
MAIL_HOST=smtp.world4you.com
MAIL_PORT=465
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_FROM_ADDRESS="noreply@gl-ventures.at"
MAIL_FROM_NAME="${APP_NAME}"

# Google Drive (kostenloses Google-Cloud-Projekt, siehe README)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=https://mycz.gl-ventures.at/google/callback
GOOGLE_DRIVE_ROOT_FOLDER=Immobilien

# Deploy-Hook (mind. 32 Zeichen, gleicher Wert als GitHub-Secret DEPLOY_TOKEN)
DEPLOY_TOKEN=

# Erster Benutzer, wird beim ersten Deploy angelegt (danach entfernen)
ADMIN_NAME=
ADMIN_EMAIL=
ADMIN_PASSWORD=
